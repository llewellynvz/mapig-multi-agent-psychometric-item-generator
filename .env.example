APP_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=
LOG_LEVEL=INFO
SEARCH_PROVIDER=perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai/v2
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_SEARCH_MODE=academic
PERPLEXITY_DOMAIN_FILTER=apa.org,jstor.org,sciencedirect.com,frontiersin.org,psycnet.apa.org,tandfonline.com, journals.sagepub.com, wiley.com, springer.com
PERPLEXITY_MAX_RESULTS=51

# Browser origins allowed to call the API cross-origin (comma-separated).
# Production on Vercel is same-origin and needs no entries beyond the defaults.
# If you change FRONTEND_PORT, add the matching origin here or the browser blocks every API call.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9998,http://127.0.0.1:9998

# Optional shared key for generation endpoints (cost-abuse guard; unset = open).
# The browser never sends it. If you set it, also set NEXT_PUBLIC_API_PROXY=1 so the
# frontend calls the Next.js proxy (/api/mapig/*), which injects the key server-side.
MAPIG_API_KEY=

# --- Frontend (Next.js) ---
# Backend base URL for the browser. Leave unset for the defaults: same-origin on
# Vercel (vercel.json rewrites /v1/* and /healthz), http://localhost:8000 locally.
# NEXT_PUBLIC_API_URL=

# Opt-in server-side proxy. When "1", the browser calls /api/mapig/* and the Next.js
# route handler forwards to MAPIG_BACKEND_URL, adding X-API-Key from MAPIG_API_KEY.
# Never put the key in a NEXT_PUBLIC_* variable: those are shipped to the browser.
NEXT_PUBLIC_API_PROXY=
# Server-only backend URL used by the proxy. Default: NEXT_PUBLIC_API_URL, then
# https://$VERCEL_URL on Vercel, then http://localhost:8000.
MAPIG_BACKEND_URL=

# Synthetic-respondent pilot (simulated data, item triage only)
SYNTHETIC_PILOT_ENABLED=false
SYNTHETIC_N_RESPONDENTS=50
